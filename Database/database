FOR EACH ROW
BEGIN
    INSERT INTO Third_year (
        prnno, studname, studdob, address, pincode, email, phone_no, gender, branch, 
        division, year, parentsphone, batch, batchYear, rollno, total_fees, 
        paid_fees, schlorship_form_status, first_installment, second_installment, 
        exam_form_status, academic_status, SGPA, CGPA
    )
    VALUES (
        OLD.prnno, OLD.studname, OLD.studdob, OLD.address, OLD.pincode, OLD.email, OLD.phone_no, 
        OLD.gender, OLD.branch, OLD.division, OLD.year, OLD.parentsphone, OLD.batch, 
        OLD.batchYear, OLD.rollno, OLD.total_fees, OLD.paid_fees, OLD.schlorship_form_status, 
        OLD.first_installment, OLD.second_installment, OLD.exam_form_status, 
        OLD.academic_status, OLD.SGPA, OLD.CGPA
    );
END$$

