CREATE TABLE students (
    prnno BIGINT NOT NULL UNIQUE,           -- PRN Number (Unique identifier )
    studname VARCHAR(100) NOT NULL,         -- Student Name
    studdob DATE NOT NULL,                  -- Student Date of Birth
    address TEXT NOT NULL,                  -- Address
    pincode CHAR(6) NOT NULL,               -- Pincode (allow only 6-digit code)
    email VARCHAR(100) NOT NULL UNIQUE,     -- Email 
    phone_no CHAR(10) NOT NULL UNIQUE,      -- Phone Number (only 10-digit)
    gender ENUM('Male', 'Female', 'Other') NOT NULL, -- Gender
    branch VARCHAR(50) NOT NULL,            -- Branch 
    division CHAR(1) NOT NULL,              -- Division 
    year INT NOT NULL,                      -- Year of Study 
    parentsphone CHAR(10) NOT NULL,         -- Parent's Phone Number (10-digit)
    batch VARCHAR(20) NOT NULL,             -- Batch
    batchYear INT NOT NULL,                 -- Batch Year
    rollno INT NOT NULL UNIQUE,             -- Roll Number (Unique)
    PRIMARY KEY (prnno)                     -- Set PRN Number as Primary Key
);


