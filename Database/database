-- view for bonafid-certificate
CREATE VIEW student_info AS
SELECT 
    prnno, 
    studname, 
    studdob, 
    branch,
    YEAR(CURDATE()) AS currentYear,  -- Calculate the current year
    NULL AS reason,                  -- Placeholder for reason (can be updated later)
    NULL AS status                   -- Placeholder for status (can be updated later)
FROM students;


-- table
CREATE TABLE bonafide (
    prnno BIGINT NOT NULL,                 -- PRN Number (Unique identifier)             -- Current Year (calculated from the system)
    reason TEXT,                           -- Reason for the bonafide request (Optional)
    status ENUM('Pending', 'Approved','Rejected','Completed') DEFAULT 'Pending', -- Status (Default: Pending)
    rejected VARCHAR(150) DEFAULT 'NO',
    PRIMARY KEY (prnno)                    -- Set PRN Number as Primary Key
);


CREATE TABLE leaving_certificate (
    prnno INT PRIMARY KEY,         -- PRN number as the primary key
    section TINYINT DEFAULT 1,               -- Section as a 2-digit number
    reject TEXT DEFAULT 'NO'  ,                 -- Remark as a text field
    reason VARCHAR(200),
    remark VARCHAR(20),
    status ENUM('Pending' , 'Approved' , 'Rejected' , 'Completed') DEFAULT "Pending"
);

CREATE TABLE distributed_bonafides(
    prnno BIGINT NOT NULL,                 -- PRN Number (Unique identifier)             -- Current Year (calculated from the system)
    reason TEXT,                           -- Reason for the bonafide request (Optional)
    status ENUM('Pending', 'Approved','Rejected','Completed') DEFAULT 'Pending', -- Status (Default: Pending)
    rejected VARCHAR(150) DEFAULT 'NO',
    distributed_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (prnno) 
)




CREATE TABLE first_year (
    prnno BIGINT NOT NULL UNIQUE,           -- PRN Number (Unique identifier )
    studname VARCHAR(100) NOT NULL,         -- Student Name
    studdob DATE NOT NULL,                  -- Student Date of Birth
    address TEXT NOT NULL,                  -- Address
    pincode CHAR(6) NOT NULL,               -- Pincode (allow only 6-digit code)
    email VARCHAR(100) NOT NULL UNIQUE,     -- Email 
    phone_no CHAR(10) NOT NULL UNIQUE,      -- Phone Number (only 10-digit)
    gender ENUM('Male', 'Female', 'Other') NOT NULL, -- Gender
    branch VARCHAR(50) NOT NULL,            -- Branch 
    division CHAR(1) NOT NULL,              -- Division 
    year INT NOT NULL,                      -- Year of Study 
    parentsphone CHAR(10) NOT NULL,         -- Parent's Phone Number (10-digit)
    batch VARCHAR(20) NOT NULL,             -- Batch
    batchYear INT NOT NULL,                 -- Batch Year
    rollno INT NOT NULL UNIQUE,             -- Roll Number (Unique)                  
    total_fees INT,
    paid_fees INT,
    schlorship_form_status TINYINT(1),      -- Changed to TINYINT for boolean-like state
    first_installment INT,
    second_installment INT,
    exam_form_status TINYINT(1),            -- Changed to TINYINT for boolean-like state
    academic_status TINYINT(1),             -- Fixed typo and changed to TINYINT
    SGPA DECIMAL(4,2),
    CGPA DECIMAL(4,2),
    PRIMARY KEY (prnno)                 
);


DELIMITER $$

CREATE TRIGGER before_second_year_update
